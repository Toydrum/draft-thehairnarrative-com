{
  "version": 1,
  "domain": "thehairnarrative.com",
  "pageId": "not-found",
  "components": [
    {
      "id": "not-foundSection",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-paddingInline-24px ank-paddingBlock-96px ank-paddingBlock-lg-128px ank-boxSizing-borderMINbox ank-color-textColor ank-bg-bgColor",
        "components": [
          "not-foundFrame"
        ],
        "id": "not-found-section"
      }
    },
    {
      "id": "not-foundEyebrow",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.sections.not-found.eyebrow",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "thnBooksawEyebrow ank-color-linkColor"
      }
    },
    {
      "id": "not-foundTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.sections.not-found.title",
      "config": {
        "tag": "h1",
        "text": "",
        "classes": "thnBooksawHeroTitleCompact"
      }
    },
    {
      "id": "not-foundBody",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.sections.not-found.body",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "thnBooksawBodyCopy ank-color-secondaryTextColor ank-maxWidth-600px"
      }
    },
    {
      "id": "not-foundCtaRule",
      "type": "icon",
      "config": {
        "iconName": "→",
        "ariaHidden": true,
        "classes": "thnBooksawBodyFont ank-fontSize-24px ank-lineHeight-1 ank-flexShrink-0"
      }
    },
    {
      "id": "not-foundCta",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.sections.not-found.cta.label;set:config.href,i18n,page.sections.not-found.cta.href",
      "config": {
        "id": "not-foundCta-link",
        "href": "/",
        "text": "",
        "rel": "noopener",
        "components": [
          "not-foundCtaRule"
        ],
        "classes": "thnBooksawCtaLink ank-color-linkColor"
      }
    },
    {
      "id": "not-foundSecondaryCtaRule",
      "type": "icon",
      "config": {
        "iconName": "→",
        "ariaHidden": true,
        "classes": "thnBooksawBodyFont ank-fontSize-24px ank-lineHeight-1 ank-flexShrink-0"
      }
    },
    {
      "id": "not-foundSecondaryCta",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.sections.not-found.secondaryCta.label;set:config.href,i18n,page.sections.not-found.secondaryCta.href",
      "config": {
        "id": "not-foundSecondaryCta-link",
        "href": "/",
        "text": "",
        "rel": "noopener",
        "components": [
          "not-foundSecondaryCtaRule"
        ],
        "classes": "thnBooksawCtaLink ank-color-linkColor"
      }
    },
    {
      "id": "not-foundContent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexDirection-column ank-minWidth-0 ank-alignItems-center ank-textAlign-center ank-gap-24px",
        "components": [
          "not-foundEyebrow",
          "not-foundTitle",
          "not-foundBody",
          "not-foundActions"
        ]
      }
    },
    {
      "id": "not-foundFrame",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-maxWidth-760px ank-marginInline-auto ank-minWidth-0",
        "components": [
          "not-foundContent"
        ]
      }
    },
    {
      "id": "pageMain",
      "type": "container",
      "config": {
        "tag": "main",
        "tabindex": -1,
        "classes": "thnBooksawBodyFont ank-width-100per ank-minWidth-0 ank-bg-bgColor ank-color-textColor",
        "components": [
          "not-foundSection"
        ],
        "id": "page-main"
      }
    },
    {
      "id": "not-foundActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexDirection-column ank-flexDirection-sm-row ank-flexWrap-wrap ank-justifyContent-center ank-alignItems-center ank-gap-16px ank-marginTop-8px",
        "components": [
          "not-foundCta",
          "not-foundSecondaryCta"
        ]
      }
    }
  ]
}
