      "valueInstructions": "set:config.activeId,varOr,journalDesk.uiLang,en",
      "eventInstructions": "fixedArticleAction:uiLanguage"
    },
    {
      "id": "deskAll",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed"
      },
      "valueInstructions": "set:config.label,i18n,desk.list;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "fixedArticleAction:list"
    },
    {
      "id": "deskLogout",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed"
      },
      "valueInstructions": "set:config.label,i18n,desk.signout;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "protectedAuthorAuth:logout"
    },
