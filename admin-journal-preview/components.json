        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "inputType": "email",
        "required": true
      },
      "valueInstructions": "set:config.label,i18n,desk.email"
    },
    {
      "id": "reauthPassword",
      "type": "input",
      "config": {
        "fieldId": "password",
