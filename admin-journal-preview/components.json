        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "inputType": "password",
        "required": true
      },
      "valueInstructions": "set:config.label,i18n,desk.password"
    },
    {
      "id": "reauthLogin",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed",
