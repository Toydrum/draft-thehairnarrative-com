      "type": "interaction-scope",
      "config": {
        "scopeId": "reauthSignin",
        "tag": "form",
        "classes": "deskStack",
        "components": [
          "reauthEmail",
          "reauthPassword",
          "reauthLogin"
        ]
      },
      "condition": "all:varEq,journalAuth.challenge,signin"
    },
