      "condition": "all:varEq,journalDesk.publicationAvailable,false"
    },
    {
      "id": "deskError",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "deskError"
      },
      "valueInstructions": "set:config.text,i18n,desk.error",
      "condition": "all:var,journalDesk.error"
    },
    {
      "id": "reauthTitle",
      "type": "text",
      "config": {
        "tag": "h2",
