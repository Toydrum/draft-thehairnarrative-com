    },
    "seo": {
      "siteName": "The Hair Narrative",
      "title": "The Hair Narrative | Observe, understand and create",
      "description": "An editorial and educational space devoted to observing, understanding and practising the art of hairstyling.",
      "canonicalOrigin": "https://thehairnarrative.com",
      "enforceCanonicalHost": false,
      "forceHttps": true,
      "robots": "index,follow,max-image-preview:large",
