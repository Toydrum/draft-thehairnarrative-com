      "id": "reauthNote",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "thnBooksawBodyCopy"
      },
      "valueInstructions": "set:config.text,i18n,desk.reauthNote"
    },
    {
      "id": "reauthEmail",
      "type": "input",
      "config": {
        "fieldId": "email",
        "controlType": "text",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "inputType": "email",
        "required": true
      },
      "valueInstructions": "set:config.label,i18n,desk.email"
    },
    {
      "id": "reauthPassword",
      "type": "input",
      "config": {
        "fieldId": "password",
        "controlType": "text",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "inputType": "password",
        "required": true
      },
      "valueInstructions": "set:config.label,i18n,desk.passwordLabel"
    },
    {
      "id": "reauthLogin",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed",
        "disabledWhenInvalidScope": true
      },
      "valueInstructions": "set:config.label,i18n,desk.signin;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "protectedAuthorAuth:signin"
    },
    {
      "id": "reauthSignin",
      "type": "interaction-scope",
      "config": {
        "scopeId": "reauthSignin",
        "tag": "form",
        "classes": "deskStack",
        "components": [
          "reauthEmail",
          "reauthPassword",
          "reauthLogin"
        ]
      },
      "condition": "all:varEq,journalAuth.challenge,signin"
    },
    {
      "id": "reauthSetupNote",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "thnBooksawBodyCopy"
      },
      "valueInstructions": "set:config.text,i18n,desk.setupNote"
