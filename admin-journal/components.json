        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed"
      },
      "valueInstructions": "set:config.label,i18n,desk.setup;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "protectedAuthorAuth:setup"
    },
