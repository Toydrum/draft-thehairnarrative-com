      },
      "valueInstructions": "set:config.label,i18n,desk.verify;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "protectedAuthorAuth:verify"
    },
    {
      "id": "reauthEnrollment",
      "type": "interaction-scope",
      "config": {
        "scopeId": "reauthEnrollment",
        "tag": "form",
        "classes": "deskStack",
        "components": [
          "reauthEnrollmentCode",
          "reauthEnrollmentVerify"
        ]
      },
      "condition": "all:varEq,journalAuth.challenge,VERIFY_SETUP"
    },
    {
      "id": "reauthPanel",
      "type": "container",
      "config": {
        "id": "reauthPanel",
        "tag": "div",
        "classes": "deskStack deskCard",
        "components": [
          "reauthTitle",
          "reauthNote",
          "reauthSignin",
          "reauthChallenge",
          "reauthSetup",
          "reauthQr",
          "reauthManual",
          "reauthEnrollment",
          "reauthNewPassword",
          "reauthError"
        ]
      },
      "condition": "all:varEq,journalDesk.reauthRequired,true"
    },
    {
      "id": "search",
      "type": "input",
      "config": {
        "fieldId": "search",
        "controlType": "text",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "inputType": "search"
      },
      "valueInstructions": "set:config.label,i18n,desk.search",
      "eventInstructions": "fixedArticleAction:filter"
    },
    {
      "id": "seriesFilter",
      "type": "input",
      "config": {
        "fieldId": "seriesId",
        "controlType": "select",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "options": [
          {
            "value": "",
            "label": "All series"
          },
          {
            "value": "form-movement",
            "label": "Form & movement"
          },
          {
            "value": "observation-process",
            "label": "Observation & process"
          },
          {
            "value": "bridal-forms",
            "label": "Bridal forms"
          }
        ]
      },
      "valueInstructions": "set:config.label,i18n,desk.series;set:config.options,var,journalDesk.seriesFilterOptions",
      "eventInstructions": "fixedArticleAction:filter"
    },
    {
      "id": "stateFilter",
      "type": "input",
      "config": {
        "fieldId": "state",
        "controlType": "select",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "options": [
          {
            "value": "",
            "label": "All states"
          },
          {
            "value": "draft",
            "label": "Draft"
          },
          {
            "value": "published",
            "label": "Published"
          }
        ]
      },
      "valueInstructions": "set:config.label,i18n,desk.allStates;set:config.options,var,journalDesk.stateOptions",
      "eventInstructions": "fixedArticleAction:filter"
    },
    {
      "id": "filters",
      "type": "container",
      "config": {
        "id": "filters",
        "tag": "div",
        "classes": "ank-display-grid ank-gridTemplateColumns-1fr ank-gridTemplateColumns-md-2fr__1fr__1fr ank-gap-18px",
        "components": [
          "search",
          "seriesFilter",
          "stateFilter"
        ]
      }
    },
    {
      "id": "listLocale",
      "type": "tab-group",
      "config": {
        "tabs": [
          {
            "id": "en",
            "label": "English"
          },
          {
            "id": "es",
            "label": "Español"
          }
        ],
        "tabListClasses": "deskRow",
        "tabButtonClasses": "deskTab",
        "activeTabButtonClasses": "deskActiveTab",
        "panelsClasses": "ank-display-none"
      },
      "valueInstructions": "set:config.activeId,varOr,journalDesk.selectedLocale,en",
      "eventInstructions": "fixedArticleAction:locale"
    },
    {
      "id": "articleTable",
      "type": "generic-table",
      "config": {
        "columns": [
          {
            "id": "title",
            "header": "Title",
            "valuePath": "title",
            "emptyText": "Untitled"
          },
          {
            "id": "enState",
            "header": "EN",
            "valuePath": "enState"
          },
          {
            "id": "esState",
            "header": "ES",
            "valuePath": "esState"
          }
        ],
        "rowsSource": {
          "source": "var",
          "path": "journalDesk.rows",
          "fallback": []
        },
        "rowIdPath": "articleId",
        "rowActions": [
          {
            "id": "edit",
            "label": "Edit"
          },
          {
            "id": "preview",
            "label": "Preview"
          }
        ],
        "eventPayloadFields": [
          "articleId"
        ],
        "classes": "ank-display-none ank-display-md-block",
        "tableWrapperClasses": "ank-width-100per ank-overflowX-auto",
        "tableClasses": "deskTable",
        "headerCellClasses": "deskTableCell",
        "actionCellClasses": "deskTableCell",
        "actionButtonClasses": "deskButton",
        "emptyText": "No articles yet. Start with your first story.",
        "pagination": {
          "enabled": true,
          "pageSize": 12
        }
      },
      "valueInstructions": "set:config.loading,varOr,journalDesk.busy,false;set:config.emptyText,i18n,desk.empty;set:config.columns.0.header,i18n,desk.articleTitle;set:config.rowActions.0.label,i18n,desk.edit;set:config.rowActions.1.label,i18n,desk.preview",
      "eventInstructions": "fixedArticleAction:row"
    },
    {
      "id": "articleCard",
      "type": "generic-card",
      "config": {
        "variant": "feature",
        "classes": "deskCard deskStack",
        "featureTitleClasses": "thnBooksawCardTitle",
        "featureDescriptionClasses": "deskMuted",
        "linkLabel": "Edit",
        "linkClasses": "deskButton",
        "target": "_self"
      },
      "valueInstructions": "set:config.linkLabel,i18n,desk.edit"
    },
    {
      "id": "articleCards",
      "type": "container",
      "config": {
        "id": "articleCards",
        "tag": "div",
        "classes": "deskStack ank-display-md-none",
        "components": []
      },
      "loopConfig": {
        "source": "var",
        "path": "journalDesk.rows",
        "templateId": "articleCard",
        "idPrefix": "journalCard",
        "bindings": [
          {
            "to": "config.title",
            "sources": [
              "title"
            ]
          },
          {
            "to": "config.description",
            "sources": [
              "stateLabel"
            ]
          },
          {
            "to": "config.linkHref",
            "sources": [
              "editPath"
            ]
          }
        ]
      }
    },
    {
      "id": "listIntroTitle",
      "type": "text",
      "config": {
        "tag": "h2",
        "text": "",
        "classes": "thnBooksawSectionTitle"
      },
      "valueInstructions": "set:config.text,i18n,desk.private"
    },
    {
      "id": "listIntroText",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "thnBooksawBodyCopy"
      },
      "valueInstructions": "set:config.text,i18n,desk.intro"
    },
