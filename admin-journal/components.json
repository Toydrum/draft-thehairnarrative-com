    {
      "id": "reauthManual",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "deskMuted ank-overflowWrap-anywhere"
      },
      "valueInstructions": "set:config.text,varOr,journalAuth.manualKey,"
    },
    {
      "id": "reauthNewPw",
      "type": "input",
      "config": {
        "fieldId": "newPassword",
        "controlType": "text",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "inputType": "password",
        "required": true
      },
      "valueInstructions": "set:config.label,i18n,desk.newPassword"
