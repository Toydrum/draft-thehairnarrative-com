      "id": "newArticle",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed"
      },
      "valueInstructions": "set:config.label,i18n,desk.new;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "fixedArticleAction:new"
    },
    {
      "id": "listIntro",
      "type": "container",
      "config": {
        "id": "listIntro",
        "tag": "div",
        "classes": "deskStack",
        "components": [
          "listIntroTitle",
          "listIntroText",
          "newArticle"
        ]
      }
    },
    {
      "id": "deskMain",
      "type": "container",
      "config": {
        "id": "deskMain",
        "tag": "main",
        "classes": "deskStack ank-paddingBlock-38px",
        "components": [
          "listIntro",
          "filters",
          "listLocale",
          "deskError",
          "articleTable",
          "articleCards",
          "publicationNote"
        ]
      }
    },
    {
      "id": "deskFooter",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "deskMuted ank-paddingBlock-24px ank-borderTopWidth-1px ank-borderTopStyle-solid ank-borderColor-HASHd4d0c7"
      },
      "valueInstructions": "set:config.text,i18n,desk.footer"
    },
    {
      "id": "deskShell",
      "type": "container",
      "config": {
        "id": "deskShell",
        "tag": "div",
        "classes": "thnBooksawBodyFont ank-boxSizing-borderMINbox ank-width-100per ank-maxWidth-1160px ank-paddingInline-20px ank-marginInline-auto ank-color-textColor",
        "components": [
          "deskHeader",
          "deskMain",
          "deskFooter"
        ]
      }
    }
  ]
}
