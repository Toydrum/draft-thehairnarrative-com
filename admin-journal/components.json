        "classes": "deskStack",
        "components": [
          "reauthChallengeCode",
          "reauthChallengeVerify"
        ]
      },
      "condition": "all:varEq,journalAuth.challenge,SOFTWARE_TOKEN_MFA"
    },
    {
      "id": "reauthEnrollmentCode",
      "type": "input",
      "config": {
        "fieldId": "code",
        "controlType": "text",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "required": true,
        "validation": [
          {
            "type": "pattern",
            "value": "^[0-9]{6}$",
            "message": "6 digits / 6 dígitos"
          }
        ]
      },
      "valueInstructions": "set:config.label,i18n,desk.code"
    },
    {
      "id": "reauthEnrollmentVerify",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed",
