      "id": "reauthPwBtn",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed",
        "disabledWhenInvalidScope": true
      },
      "valueInstructions": "set:config.label,i18n,desk.continue;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "protectedAuthorAuth:challenge"
    },
    {
      "id": "reauthNewPassword",
      "type": "interaction-scope",
      "config": {
        "scopeId": "reauthNewPassword",
        "tag": "form",
        "classes": "deskStack",
        "components": [
          "reauthNewPw",
          "reauthPwBtn"
        ]
      },
      "condition": "all:varEq,journalAuth.challenge,NEW_PASSWORD_REQUIRED"
    },
    {
      "id": "reauthError",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "deskError"
      },
      "valueInstructions": "set:config.text,i18n,desk.authError",
      "condition": "all:varEq,journalAuth.error,authentication_failed"
    },
    {
      "id": "reauthChallengeCode",
      "type": "input",
      "config": {
        "fieldId": "code",
        "controlType": "text",
        "classes": "deskField",
        "labelClasses": "deskLabel",
        "inputClasses": "deskInput",
        "errorClasses": "deskError",
        "required": true,
        "validation": [
          {
            "type": "pattern",
            "value": "^[0-9]{6}$",
            "message": "6 digits / 6 dígitos"
          }
        ]
      },
      "valueInstructions": "set:config.label,i18n,desk.code"
    },
    {
      "id": "reauthChallengeVerify",
      "type": "button",
      "config": {
        "type": "button",
        "label": "",
        "classes": "deskButton",
        "loadingClasses": "ank-opacity-0_6",
        "disabledClasses": "ank-opacity-0_45 ank-cursor-notMINallowed",
        "disabledWhenInvalidScope": true
      },
      "valueInstructions": "set:config.label,i18n,desk.verify;set:config.loading,varOr,journalAuth.busy,false",
      "eventInstructions": "protectedAuthorAuth:challenge"
    },
    {
      "id": "reauthChallenge",
      "type": "interaction-scope",
      "config": {
